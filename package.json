    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "lucide": "^0.544.0",
    "marked": "^16.4.2",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
