NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# Upstream Azure OpenAI-compatible service
AI_API_ENDPOINT=https://your-ai-gateway.example.com
AI_API_KEY=replace-me
AI_API_VERSION=2025-04-01-preview
AI_MODEL_DEPLOYMENTS={"gpt-5.4-mini":"gpt-5.4-mini","gpt-5.4":"gpt-5.4"}
AI_DEFAULT_MODEL=gpt-5.4-mini
# Generate with: openssl rand -base64 32
PROVIDER_SETTINGS_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# PostgreSQL
DATABASE_URL=postgres://chatstudio:chatstudio@database:5432/chatstudio
POSTGRES_DB=chatstudio
POSTGRES_USER=chatstudio
POSTGRES_PASSWORD=chatstudio

# Microsoft Entra ID: separate SPA and API registrations
ENTRA_TENANT_ID=your-tenant-id
ENTRA_SPA_CLIENT_ID=your-spa-client-id
ENTRA_API_CLIENT_ID=your-api-client-id
ENTRA_API_SCOPE=access_as_user
ENTRA_ADMIN_ROLE=ChatStudio.Admin

# Local-only escape hatch. Never enable in a shared deployment.
AUTH_DISABLED=false
MAX_UPLOAD_MB=20
UPSTREAM_TIMEOUT_MS=60000